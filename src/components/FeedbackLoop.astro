---
// The safety loop after go-live: every incident or near miss feeds back into the hazard log.
const nodes = [
  ['Something happens', 'An incident or near miss'],
  ['Record it', 'In the incident log'],
  ['CSO reviews', 'Is it a new hazard, or a control failing?'],
  ['Update the hazard log', 'New or stronger controls (or mitigations)'],
  ['Tell people', 'The patient, staff, the supplier, and the national Learning from Patient Safety Events (LFPSE) service if needed'],
];
const R = 128, cx = 180, cy = 180;
const pos = nodes.map((_, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return [cx + R * Math.cos(a), cy + R * Math.sin(a)];
});
---
<figure class="fl">
  <svg viewBox="0 0 360 360" role="img" aria-label="A loop of five steps: something happens, record it, CSO reviews, update the hazard log, tell people, then back to the start">
    <circle cx={cx} cy={cy} r={R} class="ring" />
    <circle cx={cx} cy={cy} r={R} class="runner" />
    <text x={cx} y={cy - 6} text-anchor="middle" class="mid">Each loop makes</text>
    <text x={cx} y={cy + 16} text-anchor="middle" class="mid">the tool safer</text>
    {pos.map(([x, y], i) => (
      <g class="node" style={`--d:${i * 1.2}s`}>
        <circle cx={x} cy={y} r="24" />
        <text x={x} y={y + 7} text-anchor="middle" class="num">{i + 1}</text>
      </g>
    ))}
  </svg>
  <ol class="fl-list">
    {nodes.map(([t, d], i) => <li style={`--d:${i * 1.2}s`}><strong>{t}</strong><span>{d}</span></li>)}
  </ol>
</figure>
<style>
  .fl { margin: 1.5rem 0; display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 1.5rem; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 1.25rem; }
  .ring { fill: none; stroke: var(--line); stroke-width: 10; }
  .runner { fill: none; stroke: #92d050; stroke-width: 10; stroke-linecap: round; stroke-dasharray: 90 714; transform-origin: 180px 180px; transform: rotate(-90deg); animation: run 6s linear infinite; }
  @keyframes run { to { transform: rotate(270deg); } }
  .mid { font-family: var(--font-display); font-weight: 700; font-size: 17px; fill: var(--fg); }
  .node circle { fill: var(--navy); stroke: var(--surface); stroke-width: 4; animation: lit 6s linear infinite; animation-delay: var(--d); }
  .num { fill: #fff; font-family: var(--font-display); font-weight: 800; font-size: 20px; }
  @keyframes lit { 0%, 18% { fill: #057092; } 20%, 100% { fill: #032c47; } }
  .fl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; counter-reset: f; }
  .fl-list li { counter-increment: f; display: grid; padding: 0.55rem 0.8rem 0.55rem 3rem; border-radius: 10px; background: var(--bg); position: relative; animation: litrow 6s linear infinite; animation-delay: var(--d); }
  .fl-list li::before { content: counter(f); position: absolute; left: 0.7rem; top: 0.6rem; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-weight: 800; font-size: 0.85rem; }
  .fl-list span { font-size: 0.88rem; color: var(--muted); }
  @keyframes litrow { 0%, 18% { background: var(--soft-teal); } 20%, 100% { background: var(--bg); } }
  @media (max-width: 680px) { .fl { grid-template-columns: minmax(0, 1fr); } .fl svg { max-width: 240px; margin-inline: auto; } }
</style>
