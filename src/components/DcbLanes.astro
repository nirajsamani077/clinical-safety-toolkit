---
// Two lanes: the supplier's safety work (DCB0129) hands over to the practice's (DCB0160).
const sup = ['Hazard log for the product', 'Clinical safety case report', 'Signed by their CSO', 'Shared with you'];
const you = ['Read their documents', 'Add your own local hazards', 'Your safety case report', 'Signed by your CSO', 'Go live and keep watch'];
---
<figure class="lanes" aria-label="The supplier's DCB0129 work is handed to the practice, which builds its own DCB0160 work on top">
  <div class="lane l-sup">
    <p class="lh"><b>DCB0129</b>The supplier</p>
    <ol>{sup.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ol>
  </div>
  <div class="hand" aria-hidden="true"><span>Handed over</span></div>
  <div class="lane l-you">
    <p class="lh"><b>DCB0160</b>Your practice</p>
    <ol>{you.map((t, i) => <li style={`--i:${i + 4}`}>{t}</li>)}</ol>
  </div>
  <figcaption>Their documents cover the product. Yours cover how your practice uses it: your patients, your staff, your workflows.</figcaption>
</figure>
<style>
  .lanes { margin: 1.5rem 0; display: grid; gap: 0; }
  .lane { display: grid; grid-template-columns: 10rem minmax(0, 1fr); align-items: stretch; border-radius: 18px; overflow: hidden; }
  .l-sup { background: color-mix(in srgb, #920570 10%, var(--surface)); }
  .l-you { background: color-mix(in srgb, #057092 10%, var(--surface)); }
  .lh { margin: 0; padding: 1rem; display: grid; align-content: center; gap: 0.2rem; color: #fff; font-weight: 600; }
  .lh b { font: 800 1.3rem var(--font-display); }
  .l-sup .lh { background: #920570; } .l-you .lh { background: #057092; }
  .lane ol { list-style: none; margin: 0; padding: 0.8rem; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 0.7rem; align-items: stretch; }
  .lane li { position: relative; background: var(--surface); border-radius: 10px; padding: 0.55rem 0.7rem; font-weight: 600; font-size: 0.9rem; line-height: 1.3; display: grid; align-items: center; box-shadow: 0 2px 6px rgba(3, 44, 71, 0.07); animation: lane-in 0.45s ease both; animation-delay: calc(var(--i) * 0.12s); }
  .lane li + li::before { content: '›'; position: absolute; left: -0.55rem; top: 50%; translate: 0 -50%; font-weight: 800; color: var(--muted); }
  .hand { display: grid; justify-items: center; height: 2.6rem; position: relative; }
  .hand::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 3px dashed #b04e0a; }
  .hand span { align-self: center; background: #b04e0a; color: #fff; font: 700 0.78rem var(--font-body); padding: 0.2rem 0.6rem; border-radius: 99px; position: relative; text-transform: uppercase; letter-spacing: 0.05em; }
  .lanes figcaption { margin-top: 0.75rem; color: var(--muted); font-size: 0.93rem; }
  @keyframes lane-in { from { transform: translateX(-10px); } to { transform: none; } }
  @media (max-width: 640px) { .lane { grid-template-columns: minmax(0, 1fr); } .lh { grid-template-columns: auto 1fr; align-items: baseline; gap: 0.6rem; } .lane ol { grid-auto-flow: row; grid-auto-columns: auto; } .lane li + li::before { display: none; } }
</style>
