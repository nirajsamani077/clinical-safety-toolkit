---
// A static "bow-tie" summary: causes, prevent controls, hazard, limit controls, harms.
// One toggle switches between the garden and Oakfield Surgery. Nothing moves on its own.
const M = {
  garden: {
    label: 'The garden trampoline',
    hazard: 'A child falls or collides while bouncing',
    causes: ['Three children bouncing at once', 'No net round the edge', 'Nobody watching'],
    harms: [['Bruises', 'Minor'], ['A broken arm', 'Considerable'], ['A head injury', 'Major']],
    prevent: ['One child at a time', 'A safety net'],
    limit: ['An adult watching who knows first aid', 'Soft ground and spring pads'],
    before: 3, after: 2,
  },
  practice: {
    label: 'Oakfield Surgery (made up)',
    hazard: 'Urgent symptoms not acted on in time',
    causes: ['A red-flag symptom typed into a routine form', 'The form is read hours later', 'Triaged without red-flag guidance'],
    harms: [['Worry and repeat contact', 'Minor'], ['Delayed treatment', 'Considerable'], ['Serious harm or death', 'Major']],
    prevent: ['Red-flag questions send emergencies to 999 or 111', 'A clinician reviews symptom requests within two hours'],
    limit: ['Same-day call-back from the duty doctor', 'A safety-netting message when the form is sent'],
    before: 3, after: 2,
  },
};
const modes = Object.entries(M);
---
<figure class="bt" data-bt data-mode="garden">
  <div class="bt-bar no-print" role="group" aria-label="Choose an example">
    {modes.map(([k, m], n) => <button type="button" class="btn btn-plain" data-mode-btn={k} aria-pressed={n === 0 ? 'true' : 'false'}>{m.label}</button>)}
  </div>
  {modes.map(([k, m]) => (
    <div class={`bt-pic m-${k}`}>
      <div class="wing left" aria-hidden="true"></div>
      <div class="wing right" aria-hidden="true"></div>
      <div class="col"><p class="col-h">What could cause it</p>{m.causes.map((c) => <div class="chip cause">{c}</div>)}</div>
      <div class="col gate"><p class="col-h">Controls that prevent</p>{m.prevent.map((c) => <div class="chip ctl">{c}</div>)}</div>
      <div class="col mid"><div class="knot"><span class="k-l">Hazard</span>{m.hazard}</div></div>
      <div class="col gate"><p class="col-h">Controls that limit harm</p>{m.limit.map((c) => <div class="chip ctl">{c}</div>)}</div>
      <div class="col"><p class="col-h">Possible harm</p>{m.harms.map(([h, s]) => <div class="chip harm"><span>{h}</span><small>{s}</small></div>)}</div>
    </div>
  ))}
  <figcaption>Read it left to right. Controls on the left stop the hazard happening; controls on the right reduce the harm if it does. With both in place, the risk score falls from 3 to 2.</figcaption>
</figure>
<script is:inline>
  document.querySelectorAll('[data-bt]').forEach(function (fig) {
    fig.querySelectorAll('[data-mode-btn]').forEach(function (b) {
      b.addEventListener('click', function () {
        fig.setAttribute('data-mode', b.getAttribute('data-mode-btn'));
        fig.querySelectorAll('[data-mode-btn]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      });
    });
  });
</script>
<style>
  .bt { margin: 1.5rem 0; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: clamp(1rem, 3vw, 1.5rem); display: grid; gap: 1rem; }
  .bt-bar { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .bt-bar .btn { padding: 0.5rem 0.9rem; font-size: 0.92rem; }
  .bt[data-mode='garden'] .m-practice, .bt[data-mode='practice'] .m-garden { display: none; }
  .bt-pic { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr) minmax(0, 1fr) minmax(0, 0.95fr) minmax(0, 1fr); gap: 0.8rem; align-items: center; padding: 0.5rem 0; }
  .wing { position: absolute; top: 0; bottom: 0; width: 46%; z-index: 0; }
  .wing.left { left: 0; background: color-mix(in srgb, #057092 12%, transparent); clip-path: polygon(0 0, 100% 40%, 100% 60%, 0 100%); }
  .wing.right { right: 0; background: color-mix(in srgb, #920570 12%, transparent); clip-path: polygon(0 40%, 100% 0, 100% 100%, 0 60%); }
  .col { position: relative; z-index: 1; display: grid; gap: 0.5rem; }
  .col-h { margin: 0; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .chip { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 0.5rem 0.7rem; font-size: 0.9rem; line-height: 1.3; }
  .cause { border-left: 5px solid #057092; }
  .harm { border-right: 5px solid #920570; display: grid; }
  .harm small { color: var(--muted); font-size: 0.75rem; }
  .gate { padding: 0.6rem; border-radius: 12px; background: color-mix(in srgb, #92d050 16%, var(--surface)); border: 2px solid #92d050; }
  .ctl { font-weight: 700; }
  .mid { justify-items: center; text-align: center; }
  .knot { background: var(--navy); color: #fff; border-radius: 50%; width: min(100%, 180px); aspect-ratio: 1; display: grid; place-content: center; padding: 1.1rem; font-family: var(--font-display); font-weight: 700; font-size: 1rem; line-height: 1.25; }
  .k-l { display: block; font-family: var(--font-body); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: #92d050; margin-bottom: 0.3rem; }
  .bt figcaption { font-size: 0.92rem; color: var(--muted); }
  @media (max-width: 820px) {
    .bt-pic { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .wing { display: none; }
    .col:not(:last-child)::after { content: '↓'; justify-self: center; color: var(--muted); font-size: 1.2rem; line-height: 1; }
    .knot { width: 150px; }
  }
</style>
