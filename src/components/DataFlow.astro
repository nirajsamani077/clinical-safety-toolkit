---
// Oakfield's online consultation tool as a swimlane data flow: one column per system or person,
// steps run top to bottom. Phones get the same steps as a list.
const lanes = [
  { t: 'Patient', c: '#057092' },
  { t: 'Kestrel Consult', c: '#920570' },
  { t: 'Heron Link', c: '#8a5f00' },
  { t: 'EMIS', c: '#3b7a14' },
  { t: 'Practice staff', c: '#0b4a6e' },
];
// [lane, lines, risk?, dashed arrow in?]
const steps = [
  [0, ['Fills in the', 'online form']],
  [1, ['Stores the request', 'on UK servers'], 3],
  [2, ['Passes the patient’s', 'details to EMIS'], 4],
  [3, ['Finds the patient,', 'saves the request']],
  [4, ['Read and triage', 'it in the tool']],
  [3, ['Staff find the', 'patient, add notes'], 1],
  [4, ['Write a reply', 'in the tool']],
  [1, ['Sends the reply by', 'text or email'], 2],
  [0, ['Gets the reply']],
  [1, ['Deletes the request', '90 days after closing'], 0, true],
];
const LW = 156, BW = 136, BH = 50, TOP = 64, P = 66;
const cx = (l) => 2 + l * LW + LW / 2;
const cy = (i) => TOP + i * P + BH / 2;
const H = TOP + steps.length * P + 4;
const arrows = steps.slice(1).map((s, k) => {
  const i = k + 1, from = s[3] ? 7 : i - 1, a = steps[from][0], b = s[0];
  const x1 = cx(a), y1 = cy(from) + BH / 2, y2 = cy(i);
  if (a === b) return { d: `M${x1 + 40} ${y1} L${x1 + 40} ${y2 - BH / 2 - 2}`, dash: s[3] };
  const x2 = b > a ? cx(b) - BW / 2 - 2 : cx(b) + BW / 2 + 2;
  return { d: `M${x1} ${y1} L${x1} ${y2} L${x2} ${y2}`, dash: s[3] };
});
---
<figure class="df">
  <svg class="df-wide" viewBox={`0 0 ${LW * 5 + 4} ${H}`} role="img" aria-labelledby="df-t1">
    <title id="df-t1">Oakfield's data flow, step by step: the patient fills in the online form; Kestrel Consult stores it; Heron Link, the integration partner, passes the patient's details to EMIS, which finds the patient and saves the request; staff read and triage it in the tool, open the patient in EMIS and add notes, and write a reply; the tool sends the reply to the patient, and deletes the request 90 days after it's closed.</title>
    <defs><marker id="dfa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="df-head" /></marker></defs>
    {lanes.map((l, i) => (<g>
      <rect x={2 + i * LW} y="2" width={LW} height={H - 4} class="df-lane" style={`--c:${l.c}`} />
      <rect x={2 + i * LW + 4} y="6" width={LW - 8} height="40" rx="8" fill={l.c} />
      <text x={cx(i)} y="31" class="df-h">{l.t}</text>
    </g>))}
    {arrows.map((a) => <path d={a.d} class={a.dash ? 'df-line dash' : 'df-line'} marker-end="url(#dfa)" />)}
    {steps.map(([l, lines, r], i) => (<g>
      <rect x={cx(l) - BW / 2} y={cy(i) - BH / 2} width={BW} height={BH} rx="9" class="df-box" style={`--c:${lanes[l].c}`} />
      {lines.map((t, j) => <text x={cx(l)} y={cy(i) + (lines.length === 1 ? 5 : j === 0 ? -3 : 13)} class="df-s">{t}</text>)}
      {r ? <g class="df-r"><rect x={cx(l) + BW / 2 - 50} y={cy(i) - BH / 2 - 11} width="56" height="20" rx="10" /><text x={cx(l) + BW / 2 - 22} y={cy(i) - BH / 2 + 3}>Risk {r}</text></g> : null}
    </g>))}
  </svg>
  <ol class="df-list">
    {steps.map(([l, lines, r]) => (<li style={`--c:${lanes[l].c}`}><span class="df-who">{lanes[l].t}</span><span>{lines.join(' ')}</span>{r ? <span class="df-rk">Risk {r}</span> : null}</li>))}
  </ol>
  <figcaption>Follow the steps down. Each colour is a system or person, and the tags mark where Oakfield's risks below come in.</figcaption>
</figure>
<style>
  .df { margin: 1.5rem 0; padding: clamp(0.8rem, 3vw, 1.2rem); border-radius: 20px; background: var(--surface); border: 1px solid var(--line); }
  .df svg { display: block; width: 100%; height: auto; }
  .df-lane { fill: color-mix(in srgb, var(--c) 5%, var(--surface)); stroke: var(--line); stroke-width: 1; }
  .df-h { fill: #fff; font: 800 13px var(--font-display, sans-serif); text-anchor: middle; }
  .df-box { fill: var(--surface); stroke: var(--c); stroke-width: 2; }
  .df-s { fill: var(--fg); font: 600 12.5px var(--font-body, sans-serif); text-anchor: middle; }
  .df-line { stroke: var(--muted); stroke-width: 2; fill: none; }
  .df-line.dash { stroke-dasharray: 5 4; }
  .df-head { fill: var(--muted); }
  .df-r rect { fill: #920570; stroke: var(--surface); stroke-width: 2; } .df-r text { fill: #fff; font: 800 11.5px var(--font-body, sans-serif); text-anchor: middle; }
  .df-list { display: none; list-style: none; margin: 0; padding: 0; counter-reset: s; }
  .df-list li { counter-increment: s; position: relative; display: grid; gap: 0.15rem; padding: 0.55rem 0.7rem 0.55rem 2.6rem; margin-bottom: 1.1rem; border: 2px solid var(--c); border-radius: 10px; background: color-mix(in srgb, var(--c) 6%, var(--surface)); font-size: 0.93rem; }
  .df-list li::before { content: counter(s); position: absolute; left: 0.55rem; top: 0.6rem; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--c); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 0.8rem; }
  .df-list li:not(:last-child)::after { content: '↓'; position: absolute; left: 50%; bottom: -1.2rem; color: var(--muted); font-weight: 800; line-height: 1; }
  .df-who { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--c); }
  .df-rk { justify-self: start; background: #920570; color: #fff; font-size: 0.75rem; font-weight: 800; border-radius: 99px; padding: 0.1rem 0.55rem; }
  .df figcaption { margin-top: 0.8rem; font-size: 0.9rem; color: var(--muted); }
  @media (max-width: 640px) { .df .df-wide { display: none; } .df .df-list { display: block; } }
</style>
