---
// The house keys story: data protection in eight clicks. Nothing moves on its own.
const frames = [
  { k: 'You’re in charge', t: 'The data controller', d: 'You decide who comes into your home, and why.', p: 'Oakfield is the data controller for its patients’ information. It decides what the online consultation tool handles and why. That responsibility stays with Oakfield even when a supplier does the work.' },
  { k: 'Someone works for you', t: 'The data processor', d: 'A cleaner comes in to do a job for you. They don’t decide what happens in your home.', p: 'The supplier is a data processor. It handles patients’ requests only on Oakfield’s instructions.' },
  { k: 'Agree it in writing', t: 'The data processing agreement (DPA)', d: 'Which rooms, which jobs, no spare keys cut, nobody else brought round.', p: 'A data processing agreement (DPA) sets out what the supplier may do with the data, where it’s kept, for how long, and who else it uses.' },
  { k: 'Think it through first', t: 'The data protection impact assessment (DPIA)', d: 'Before you hand over the keys, you think about what could go wrong and how to stop it.', p: 'The DPIA looks at the data risks before go-live: who can see requests, where they’re stored, and what happens if they leak. It works like the risk assessment in clinical safety: what could go wrong with the data, and the controls and mitigations that reduce it.' },
  { k: 'Have a good reason', t: 'The lawful basis', d: 'There’s a clear reason the cleaner is there: to clean.', p: 'Providing care is part of the practice’s public task, and health information may be used for health care, so patients don’t sign a consent form, but they must be told. Who may look is a separate rule: staff only open the records of patients they’re caring for. A receptionist looking up a neighbour’s record breaks confidentiality, even though the practice is allowed to hold it.' },
  { k: 'Tell the neighbours', t: 'Transparency', d: 'So nobody is alarmed to see a stranger letting themselves in.', p: 'Oakfield updates its privacy notice and website, so patients know the tool exists, what happens to their information, and who to ask.' },
  { k: 'Keep it secure', t: 'Data security', d: 'A key safe, an alarm code, and the door locked when they leave.', p: 'Staff log in securely (for example with two-factor authentication through an authenticator app), only people who need to can see requests, and the supplier meets NHS security standards.' },
  { k: 'Get the keys back', t: 'Ending the contract', d: 'When the cleaner stops coming, you get every key back and check no copies were made.', p: 'If Oakfield stops using the tool, the supplier returns or deletes the data and confirms it in writing.' },
];
const last = frames.length;
---
<figure class="hk" data-hk data-f={last}>
  <ol class="hk-dots no-print" aria-label="Choose a stage">
    {frames.map((f, i) => <li><button type="button" data-go={i + 1} aria-pressed={i === last - 1 ? 'true' : 'false'}><span>{i + 1}</span>{f.k}</button></li>)}
  </ol>
  <div class="hk-stage">
    <svg viewBox="0 0 640 300" role="img" aria-label="A house, its owner and a cleaner, built up one idea at a time">
      <rect class="sky" x="0" y="0" width="640" height="300" rx="16" />
      <rect class="lawn" x="0" y="258" width="640" height="42" />
      <g class="layer" data-from="1">
        <polygon class="roof" points="40,138 140,66 240,138" />
        <rect class="wall" x="56" y="136" width="168" height="122" />
        <rect class="win" x="76" y="160" width="34" height="30" /><rect class="win" x="170" y="160" width="34" height="30" />
        <rect class="door" x="120" y="196" width="40" height="62" rx="3" />
        <g class="person owner"><circle cx="275" cy="168" r="11" /><line x1="275" y1="179" x2="275" y2="222" /><polyline points="258,206 275,190 292,206" /><polyline points="263,256 275,222 287,256" /></g>
        <text class="lab" x="275" y="150" text-anchor="middle">You</text>
      </g>
      <g class="layer" data-from="1" data-to="1"><g class="key" transform="translate(296 200)"><circle cx="0" cy="0" r="7" /><line x1="7" y1="0" x2="24" y2="0" /><line x1="18" y1="0" x2="18" y2="7" /><line x1="23" y1="0" x2="23" y2="6" /></g></g>
      <g class="layer" data-from="2">
        <g class="person cleaner"><circle cx="380" cy="168" r="11" /><line x1="380" y1="179" x2="380" y2="222" /><polyline points="363,206 380,190 397,206" /><polyline points="368,256 380,222 392,256" /></g>
        <path class="bucket" d="M400 228 h22 l-3 26 h-16 z" /><path class="bucket-h" d="M402 228 q9 -14 18 0" />
        <text class="lab" x="380" y="150" text-anchor="middle">Cleaner</text>
      </g>
      <g class="layer" data-from="2" data-to="7"><g class="key" transform="translate(338 206)"><circle cx="0" cy="0" r="7" /><line x1="7" y1="0" x2="24" y2="0" /><line x1="18" y1="0" x2="18" y2="7" /><line x1="23" y1="0" x2="23" y2="6" /></g></g>
      <g class="layer" data-from="3">
        <rect class="paper" x="300" y="64" width="64" height="76" rx="6" />
        <line class="pl" x1="310" y1="82" x2="354" y2="82" /><line class="pl" x1="310" y1="94" x2="354" y2="94" /><line class="pl" x1="310" y1="106" x2="346" y2="106" /><path class="sig" d="M312 126 q8 -10 14 0 t14 0" />
        <text class="lab sm" x="332" y="56" text-anchor="middle">Agreement</text>
      </g>
      <g class="layer" data-from="4"><g transform="translate(26 -4)">
        <rect class="board" x="388" y="60" width="62" height="82" rx="6" /><rect class="clip" x="406" y="54" width="26" height="12" rx="3" />
        <path class="tick" d="M398 84 l6 6 l10 -12" /><line class="pl" x1="420" y1="84" x2="442" y2="84" />
        <path class="tick" d="M398 106 l6 6 l10 -12" /><line class="pl" x1="420" y1="106" x2="442" y2="106" />
        <text class="warn-q" x="406" y="134" text-anchor="middle">?</text><line class="pl" x1="420" y1="128" x2="442" y2="128" />
        <text class="lab sm" x="419" y="48" text-anchor="middle">Risks checked</text>
      </g></g>
      <g class="layer" data-from="5"><rect class="reason" x="320" y="266" width="140" height="28" rx="14" /><text class="reason-t" x="390" y="285" text-anchor="middle">Reason: to clean</text></g>
      <g class="layer" data-from="6">
        <polygon class="roof n" points="486,166 548,118 610,166" /><rect class="wall n" x="496" y="164" width="104" height="94" />
        <rect class="door n" x="534" y="212" width="26" height="46" rx="2" />
        <line class="post" x1="470" y1="258" x2="470" y2="200" /><rect class="notice" x="444" y="176" width="54" height="34" rx="4" />
        <line class="nl" x1="452" y1="187" x2="490" y2="187" /><line class="nl" x1="452" y1="197" x2="482" y2="197" />
      </g>
      <g class="layer" data-from="7">
        <rect class="lock" x="128" y="222" width="24" height="20" rx="4" /><path class="shackle" d="M133 222 v-7 a7 7 0 0 1 14 0 v7" />
        <circle class="alarm" cx="212" cy="148" r="8" />
      </g>
      <g class="layer" data-from="8">
        <g class="key" transform="translate(296 200)"><circle cx="0" cy="0" r="7" /><line x1="7" y1="0" x2="24" y2="0" /><line x1="18" y1="0" x2="18" y2="7" /><line x1="23" y1="0" x2="23" y2="6" /></g>
        <path class="return" d="M362 196 q-20 -18 -38 -2" /><path class="return-h" d="M322 186 l2 9 l9 -2" />
      </g>
    </svg>
    <div class="hk-text" aria-live="polite">
      {frames.map((f, i) => (
        <div class="cap" data-cap={i + 1} hidden={i !== last - 1}>
          <p class="cap-n">{i + 1} of {last}</p>
          <p class="cap-k">{f.k}</p>
          <p class="cap-t">{f.t}</p>
          <div class="pair">
            <p><span>At home</span>{f.d}</p>
            <p><span>At Oakfield Surgery</span>{f.p}</p>
          </div>
        </div>
      ))}
      <div class="hk-nav no-print">
        <button type="button" class="btn btn-plain" data-prev>Back</button>
        <button type="button" class="btn btn-primary" data-next>Next</button>
      </div>
    </div>
  </div>
</figure>

<script is:inline define:vars={{ last }}>
  (function () {
    document.querySelectorAll('[data-hk]').forEach(function (fig) {
      var n = 1;
      function show(k) {
        n = Math.max(1, Math.min(last, k));
        fig.querySelectorAll('.layer').forEach(function (g) {
          var from = +g.getAttribute('data-from'), to = +(g.getAttribute('data-to') || last);
          g.classList.toggle('on', n >= from && n <= to);
          g.classList.toggle('new', n === from);
        });
        fig.querySelectorAll('[data-cap]').forEach(function (c) { c.hidden = +c.getAttribute('data-cap') !== n; });
        fig.querySelectorAll('[data-go]').forEach(function (b) { b.setAttribute('aria-pressed', +b.getAttribute('data-go') === n ? 'true' : 'false'); });
        fig.querySelector('[data-prev]').disabled = n === 1;
        fig.querySelector('[data-next]').textContent = n === last ? 'Start again' : 'Next';
      }
      fig.classList.add('js');
      fig.querySelectorAll('[data-go]').forEach(function (b) { b.addEventListener('click', function () { show(+b.getAttribute('data-go')); }); });
      fig.querySelector('[data-prev]').addEventListener('click', function () { show(n - 1); });
      fig.querySelector('[data-next]').addEventListener('click', function () { show(n === last ? 1 : n + 1); });
      show(1);
    });
  })();
</script>

<style>
  .hk { margin: 1.5rem 0; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: clamp(1rem, 3vw, 1.5rem); display: grid; gap: 1rem; }
  .hk-dots { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .hk-dots button { display: inline-flex; align-items: center; gap: 0.4rem; border: 1px solid var(--line); background: var(--bg); color: var(--fg); border-radius: 99px; padding: 0.3rem 0.75rem 0.3rem 0.3rem; font: 700 0.85rem var(--font-body); cursor: pointer; }
  .hk-dots button span { width: 1.5rem; height: 1.5rem; border-radius: 50%; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--line); font-size: 0.78rem; }
  .hk-dots button[aria-pressed='true'] { background: #920570; color: #fff; border-color: #920570; }
  .hk-dots button[aria-pressed='true'] span { background: #fff; color: #920570; border-color: #fff; }
  .hk-stage { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  svg { display: block; width: 100%; height: auto; }
  .sky { fill: var(--soft-magenta); }
  .lawn { fill: color-mix(in srgb, #92d050 35%, var(--surface)); }
  .roof { fill: #920570; } .roof.n { fill: #5b6f7c; }
  .wall { fill: var(--surface); stroke: var(--fg); stroke-width: 3; } .wall.n { stroke: #5b6f7c; }
  .win { fill: var(--soft-teal); stroke: var(--fg); stroke-width: 2.5; }
  .door { fill: #032c47; } .door.n { fill: #5b6f7c; }
  .person circle { fill: var(--surface); stroke: var(--fg); stroke-width: 4; }
  .person line, .person polyline { fill: none; stroke: var(--fg); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .cleaner circle, .cleaner line, .cleaner polyline { stroke: #057092; }
  .bucket { fill: #057092; } .bucket-h { fill: none; stroke: #057092; stroke-width: 3; }
  .lab { font: 700 16px var(--font-display); fill: var(--fg); }
  .lab.sm { font-size: 14px; }
  .key circle, .key line { fill: none; stroke: #c98a00; stroke-width: 4; stroke-linecap: round; }
  .paper, .board { fill: #fff; stroke: var(--fg); stroke-width: 2.5; }
  .clip { fill: var(--fg); }
  .pl { stroke: #9db4c3; stroke-width: 3; stroke-linecap: round; }
  .sig { fill: none; stroke: #057092; stroke-width: 2.5; }
  .tick { fill: none; stroke: #3b7a14; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .warn-q { font: 800 20px var(--font-display); fill: #c98a00; }
  .reason { fill: #032c47; } .reason-t { font: 700 15px var(--font-body); fill: #fff; }
  .post { stroke: #5b6f7c; stroke-width: 4; } .notice { fill: #fde9b5; stroke: #c98a00; stroke-width: 2.5; } .nl { stroke: #c98a00; stroke-width: 2.5; }
  .lock { fill: #c98a00; } .shackle { fill: none; stroke: #c98a00; stroke-width: 4; }
  .alarm { fill: var(--crit); }
  .return { fill: none; stroke: #3b7a14; stroke-width: 3.5; stroke-dasharray: 6 5; } .return-h { fill: none; stroke: #3b7a14; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .hk.js .layer { opacity: 0; transition: opacity 0.45s ease; }
  .hk.js .layer.on { opacity: 1; }
  .hk.js .layer.new { animation: rise 0.5s ease; }
  @keyframes rise { from { transform: translateY(8px); } to { transform: none; } }
  .cap p { margin: 0; }
  .cap-n { font-size: 0.78rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .cap-k { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); line-height: 1.15; margin: 0.15rem 0 0.2rem !important; }
  .cap-t { font-weight: 700; color: var(--accent-2); margin-bottom: 0.9rem !important; }
  .pair { display: grid; gap: 0.6rem; }
  .pair p { padding: 0.75rem 0.9rem; border-radius: 12px; background: var(--soft-magenta); }
  .pair p + p { background: var(--soft-teal); }
  .pair span { display: block; font-size: 0.78rem; font-weight: 700; color: var(--muted); margin-bottom: 0.15rem; }
  .hk-nav { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 1rem; }
  .hk-nav .btn[disabled] { opacity: 0.4; cursor: default; }
  @media (max-width: 820px) { .hk-stage { grid-template-columns: minmax(0, 1fr); } .hk-dots { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 0.3rem; } .hk-dots button { white-space: nowrap; font-size: 0.8rem; } }
  @media print { .hk.js .layer { opacity: 1; } }
</style>
