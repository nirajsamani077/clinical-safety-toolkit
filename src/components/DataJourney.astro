---
// Where a patient's information travels, with the question to ask at each stop.
const stops = [
  { t: 'The patient', s: 'Types a request into the online form', q: 'Do they know what happens to it?', c: '#057092' },
  { t: 'The supplier’s system', s: 'Stores and sorts the request', q: 'Where is it stored, and for how long?', c: '#920570' },
  { t: 'The supplier’s subcontractors', s: 'Cloud hosting, AI models, support staff, and any company linking the tool to your clinical system', q: 'Who are they, and where are they?', c: '#920570' },
  { t: 'Practice staff', s: 'Read the request and act on it', q: 'Who can see it, and is that logged?', c: '#0b4a6e' },
  { t: 'The patient’s record', s: 'What matters is copied into the record', q: 'Is anything left behind in the tool?', c: '#3b7a14' },
];
---
<figure class="dj" aria-label="Where a patient's information travels">
  <ol>
    {stops.map((s, i) => (
      <li style={`--c:${s.c}; --i:${i}`}>
        <span class="dj-n">{i + 1}</span>
        <strong>{s.t}</strong>
        <span class="dj-s">{s.s}</span>
        <span class="dj-q">{s.q}</span>
      </li>
    ))}
  </ol>
  <figcaption>Follow one request from the patient to the record. A good data processing agreement and DPIA answer the question at every stop.</figcaption>
</figure>
<style>
  .dj { margin: 1.5rem 0; }
  .dj ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.9rem; position: relative; }
  .dj ol::before { content: ''; position: absolute; left: 8%; right: 8%; top: 22px; height: 4px; background: repeating-linear-gradient(90deg, var(--line) 0 10px, transparent 10px 18px); }
  .dj li { position: relative; display: grid; gap: 0.35rem; align-content: start; background: var(--surface); border: 1px solid var(--line); border-top: 6px solid var(--c); border-radius: 14px; padding: 2.4rem 0.9rem 0.9rem; margin-top: 22px; }
  .dj-n { position: absolute; top: -22px; left: 50%; translate: -50% 0; width: 44px; height: 44px; border-radius: 50%; background: var(--c); color: #fff; display: grid; place-items: center; font: 800 1.15rem var(--font-display); border: 4px solid var(--bg); }
  .dj strong { font-family: var(--font-display); font-size: 1.02rem; line-height: 1.25; }
  .dj-s { font-size: 0.88rem; color: var(--muted); }
  .dj-q { margin-top: 0.3rem; font-size: 0.88rem; font-weight: 700; background: var(--soft-magenta); border-radius: 8px; padding: 0.45rem 0.55rem; }
  .dj figcaption { margin-top: 0.8rem; font-size: 0.9rem; color: var(--muted); }
  @media (max-width: 820px) {
    .dj ol { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; }
    .dj ol::before { display: none; }
  }
</style>
