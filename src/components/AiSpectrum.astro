---
// The AI found in general practice, from the obvious to the easy to miss. Card colour runs green to red.
const items = [
  ['AI scribes', 'Listen to the consultation and draft notes'],
  ['AI triage and online consultation', 'Sort requests or suggest urgency'],
  ['AI receptionists', 'Answer calls or chats, book and signpost'],
  ['Results and document tools', 'File results, summarise and code letters'],
  ['Recall tools', 'Search the list to find who to invite'],
  ['Chatbots and Copilot', 'ChatGPT, Gemini, Copilot in email and Teams'],
  ['Call and meeting transcription', 'In Teams or your phone system'],
  ['Features added in updates', 'AI switched on in software you already use'],
];
const cols = ['#3b7a14', '#5a9a1c', '#86b828', '#c2b52a', '#e3a32f', '#e07f2f', '#d65a2f', '#c0392b'];
---
<figure class="spec">
  <div class="spec-ends" aria-hidden="true"><span>Clearly AI</span><span>Easy to miss</span></div>
  <div class="spec-bar" aria-hidden="true"></div>
  <ol class="spec-list">
    {items.map(([t, d], i) => (
      <li style={`--c:${cols[i]}; --i:${i}`}><strong>{t}</strong><span>{d}</span></li>
    ))}
  </ol>
  <figcaption>Your policy should cover all of these, not just the tools you bought on purpose.</figcaption>
</figure>
<style>
  .spec { margin: 1.5rem 0; }
  .spec-ends { display: flex; justify-content: space-between; font: 700 0.8rem var(--font-body); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .spec-bar { height: 10px; border-radius: 99px; margin: 0.4rem 0 0.9rem; background: linear-gradient(90deg, #3b7a14, #92d050 30%, #f0b93a 70%, #c0392b); }
  .spec-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.7rem; }
  .spec-list li { display: grid; gap: 0.3rem; align-content: start; padding: 0.8rem 0.9rem; border-radius: 14px; background: color-mix(in srgb, var(--c) 9%, var(--surface)); border: 1px solid color-mix(in srgb, var(--c) 30%, var(--line)); border-top: 6px solid var(--c); animation: drop 0.5s ease both; animation-delay: calc(var(--i) * 0.06s); }
  .spec-list strong { font-family: var(--font-display); font-size: 1rem; line-height: 1.25; }
  .spec-list span { font-size: 0.88rem; color: var(--muted); line-height: 1.4; }
  @keyframes drop { from { transform: translateY(-8px); } to { transform: none; } }
  .spec figcaption { margin-top: 0.8rem; font-size: 0.92rem; color: var(--muted); }
  @media (max-width: 820px) { .spec-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 460px) { .spec-list { grid-template-columns: minmax(0, 1fr); } }
</style>
