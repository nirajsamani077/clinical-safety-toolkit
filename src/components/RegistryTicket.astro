---
// What being on NHS England's AI scribe registry means, and what it doesn't. Styled as a ticket stub.
const yes = ['The supplier says it meets NHS England’s criteria, and has shared its evidence', 'NHS organisations can view that evidence through the national procurement hub', 'A sensible starting point for a shortlist'];
const no = ['NHS England has approved it for your practice', 'Your clinical safety assessment and DPIA are done', 'It’s right for your patients and your workflows', 'It’s a medical device, or that it isn’t'];
---
<figure class="tk">
  <div class="tk-stub">
    <span class="tk-stamp" aria-hidden="true">LISTED</span>
    <p class="tk-k">NHS England</p>
    <p class="tk-t">AI scribe supplier registry</p>
    <p class="tk-s">Self-certified</p>
  </div>
  <div class="tk-body">
    <div class="tk-yes"><p>It means</p><ul>{yes.map((t) => <li>{t}</li>)}</ul></div>
    <div class="tk-no"><p>It doesn't mean</p><ul>{no.map((t) => <li>{t}</li>)}</ul></div>
  </div>
</figure>
<style>
  .tk { margin: 1.5rem 0; display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); filter: drop-shadow(0 14px 26px rgba(3, 44, 71, 0.15)); }
  .tk-stub { position: relative; background: linear-gradient(160deg, #b04e0a, #e07a1f); color: #fff; padding: 1.4rem 1.2rem; border-radius: 18px 0 0 18px; border-right: 3px dashed rgba(255, 255, 255, 0.7); display: grid; align-content: end; gap: 0.2rem; min-height: 13rem; overflow: hidden; }
  .tk-stamp { position: absolute; top: 1.1rem; right: -0.4rem; rotate: 14deg; border: 3px solid #fff; border-radius: 8px; padding: 0.15rem 0.6rem; font: 800 1.05rem var(--font-display); letter-spacing: 0.1em; animation: stamp 0.5s cubic-bezier(.3,1.6,.5,1) 0.3s both; }
  .tk-k { margin: 0; font: 700 0.75rem var(--font-body); text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.9; }
  .tk-t { margin: 0; font: 800 1.35rem/1.15 var(--font-display); }
  .tk-s { margin: 0; font-weight: 600; opacity: 0.9; }
  .tk-body { background: var(--surface); border-radius: 0 18px 18px 0; display: grid; grid-template-columns: 1fr 1fr; }
  .tk-body > div { padding: 1.1rem 1.2rem; }
  .tk-body p { margin: 0 0 0.5rem; font: 800 1.1rem var(--font-display); }
  .tk-yes p { color: light-dark(#3b7414, color-mix(in srgb, #3b7414 42%, #fff)); } .tk-no p { color: light-dark(#c0392b, color-mix(in srgb, #c0392b 42%, #fff)); }
  .tk-no { border-left: 1px solid var(--line); }
  .tk-body ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .tk-body li { display: grid; grid-template-columns: 1.2rem minmax(0, 1fr); gap: 0.4rem; font-size: 0.95rem; }
  .tk-yes li::before { content: '✓'; color: light-dark(#3b7414, color-mix(in srgb, #3b7414 42%, #fff)); font-weight: 800; }
  .tk-no li::before { content: '✕'; color: light-dark(#c0392b, color-mix(in srgb, #c0392b 42%, #fff)); font-weight: 800; }
  @keyframes stamp { from { transform: scale(1.8); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (max-width: 700px) {
    .tk { grid-template-columns: minmax(0, 1fr); }
    .tk-stub { border-radius: 18px 18px 0 0; border-right: 0; border-bottom: 3px dashed rgba(255, 255, 255, 0.7); min-height: 0; }
    .tk-body { border-radius: 0 0 18px 18px; grid-template-columns: minmax(0, 1fr); }
    .tk-no { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
