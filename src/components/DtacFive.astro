---
// The five DTAC areas on a pentagon. Pick one to see what to look for.
const areas = [
  ['Clinical safety', 'Has the supplier done its DCB0129 safety work, with a named CSO?', 'Ask for their hazard log and safety case report.', '/explainers/dcb0129-and-dcb0160'],
  ['Data protection', 'Do they meet data protection law, with DSPT and the right agreements?', 'Use their answers to help write your DPIA.', '/information-governance/dpia'],
  ['Technical security', 'Is the product secure, with Cyber Essentials Plus and security testing?', 'Check the certificate is current.', '/explainers/cyber-security'],
  ['Interoperability', 'Does it connect to other systems using recognised standards?', 'Ask how it links to your clinical system.', '/explainers/im1'],
  ['Usability and accessibility', 'Is it easy to use, and does it meet accessibility standards?', 'Ask how it works for patients and staff with disabilities.', '/information-governance/telling-patients'],
];
const pts = areas.map((_, i) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / 5; return [150 + 105 * Math.cos(a), 140 + 105 * Math.sin(a)]; });
---
<figure class="dt" data-dt>
  <svg viewBox="0 0 300 280" aria-hidden="true">
    <polygon class="dt-poly" points={pts.map((p) => p.join(',')).join(' ')} />
    {pts.map(([x, y]) => <line class="dt-spoke" x1="150" y1="140" x2={x} y2={y} />)}
    <text x="150" y="146" text-anchor="middle" class="dt-mid">DTAC</text>
    {pts.map(([x, y], i) => <circle class="dt-dot" data-dot={i} cx={x} cy={y} r="18" />)}
    {pts.map(([x, y], i) => <text class="dt-n" x={x} y={y + 6} text-anchor="middle">{i + 1}</text>)}
  </svg>
  <div class="dt-side">
    <div class="dt-btns" role="tablist" aria-label="DTAC areas">
      {areas.map(([t], i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}><span>{i + 1}</span>{t}</button>)}
    </div>
    {areas.map(([t, q, a, href], i) => (
      <div class="dt-panel" role="tabpanel" data-p={i} hidden={i !== 0}>
        <p class="dt-q">{q}</p>
        <p><strong>Your part:</strong> {a} <a href={href}>More</a></p>
      </div>
    ))}
  </div>
</figure>
<script is:inline>
  (function () {
    document.querySelectorAll('[data-dt]').forEach(function (dt) {
      function pick(i) {
        dt.querySelectorAll('[data-i]').forEach(function (b) { b.setAttribute('aria-selected', b.dataset.i == i ? 'true' : 'false'); });
        dt.querySelectorAll('[data-p]').forEach(function (p) { p.hidden = p.dataset.p != i; });
        dt.querySelectorAll('[data-dot]').forEach(function (c) { c.classList.toggle('on', c.dataset.dot == i); });
      }
      dt.querySelectorAll('[data-i]').forEach(function (b) { b.addEventListener('click', function () { pick(b.dataset.i); }); });
      dt.querySelectorAll('[data-dot]').forEach(function (c) { c.addEventListener('click', function () { pick(c.dataset.dot); }); });
      pick(0);
    });
  })();
</script>
<style>
  .dt { margin: 1.5rem 0; display: grid; grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: 1.5rem; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 1.25rem; }
  .dt svg { width: 100%; height: auto; }
  .dt-poly { fill: color-mix(in srgb, #b04e0a 10%, transparent); stroke: #b04e0a; stroke-width: 3; stroke-linejoin: round; }
  .dt-spoke { stroke: #e9c6a8; stroke-width: 1.5; stroke-dasharray: 4 4; }
  .dt-mid { font: 800 22px var(--font-display); fill: light-dark(#b04e0a, color-mix(in srgb, #b04e0a 42%, #fff)); }
  .dt-dot { fill: #032c47; cursor: pointer; transition: fill 0.2s ease, r 0.2s ease; }
  .dt-dot.on { fill: #b04e0a; r: 22; }
  .dt-n { font: 800 16px var(--font-display); fill: #fff; pointer-events: none; }
  .dt-btns { display: grid; gap: 0.3rem; margin-bottom: 0.8rem; }
  .dt-btns button { display: flex; gap: 0.6rem; align-items: center; text-align: left; font: 700 0.95rem var(--font-body); padding: 0.45rem 0.6rem; border: 0; border-radius: 10px; background: none; color: var(--fg); cursor: pointer; }
  .dt-btns button span { width: 1.6rem; height: 1.6rem; flex: none; border-radius: 50%; display: grid; place-items: center; background: #032c47; color: #fff; font-size: 0.8rem; }
  .dt-btns button[aria-selected='true'] { background: color-mix(in srgb, #b04e0a 12%, var(--surface)); color: light-dark(#a8480a, color-mix(in srgb, #a8480a 42%, #fff)); }
  .dt-btns button[aria-selected='true'] span { background: #b04e0a; }
  .dt-panel { border-left: 5px solid #b04e0a; padding: 0.3rem 0 0.3rem 1rem; animation: fadein 0.3s ease; }
  .dt-panel p { margin: 0 0 0.4rem; }
  .dt-q { font: 700 1.08rem var(--font-display); }
  @keyframes fadein { from { transform: translateY(4px); } to { transform: none; } }
  @media (max-width: 700px) { .dt { grid-template-columns: minmax(0, 1fr); } .dt svg { max-width: 220px; margin: 0 auto; } }
</style>
